{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/product-category/marine-locks",
        "destination": "/brand/marine-locks/",
        "type": 301
      },
      {
        "source": "/home",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/company",
        "destination": "/about-us/",
        "type": 301
      },
      {
        "source": "/contact",
        "destination": "/contact-us/",
        "type": 301
      },
      {
        "source": "/articles",
        "destination": "/blog/",
        "type": 301
      },
      {
        "source": "/product-category/marine-locks/",
        "destination": "/brand/marine-locks/",
        "type": 301
      },
      {
        "source": "/home/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/company/",
        "destination": "/about-us/",
        "type": 301
      },
      {
        "source": "/contact/",
        "destination": "/contact-us/",
        "type": 301
      },
      {
        "source": "/articles/",
        "destination": "/blog/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  }
}
